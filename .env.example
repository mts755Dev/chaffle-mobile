# Local development — copy to .env (gitignored). Never commit .env.
# EAS cloud builds — set the same EXPO_PUBLIC_* keys in Expo Environment Variables:
#   https://expo.dev → your project → Environment variables
#   or: eas env:create --name EXPO_PUBLIC_SUPABASE_URL --value "..." --environment production --visibility plaintext

EXPO_PUBLIC_API_BASE_URL=https://chaffle.org
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_TERMINAL_SIMULATED=false
EXPO_PUBLIC_ADMIN_EMAIL=
