{
  "expo": {
    "name": "Chaffle",
    "slug": "chaffle",
    "scheme": "chaffle",
    "version": "1.0.1",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chaffleorg.chaffle",
      "buildNumber": "8",
      "entitlements": {
        "com.apple.developer.proximity-reader.payment.acceptance": true
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Chaffle needs your location to verify raffle eligibility in your state.",
        "NSCameraUsageDescription": "Chaffle needs camera access to scan QR codes.",
        "NSPhotoLibraryUsageDescription": "Chaffle needs photo library access to upload raffle background images.",
        "NSPhotoLibraryAddUsageDescription": "Chaffle needs permission to save images to your photo library.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "fr",
          "de",
          "es",
          "it",
          "pt",
          "ja",
          "ko",
          "zh-Hans",
          "zh-Hant",
          "ar",
          "nl",
          "pl",
          "sv",
          "da",
          "fi",
          "nb",
          "th",
          "vi",
          "id",
          "tr",
          "ru"
        ]
      }
    },
    "android": {
      "package": "com.chaffleorg.chaffle",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4697AF"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Chaffle needs photo library access to upload raffle background images.",
          "cameraPermission": "Chaffle needs camera access to scan QR codes and take raffle photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#4697AF",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chaffle needs your location to verify raffle eligibility."
        }
      ],
      [
        "@stripe/stripe-terminal-react-native",
        {
          "bluetoothBackgroundMode": false,
          "enableTapToPay": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.chaffleorg.chaffle"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "18.0"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "./plugins/withProximityReaderDiscoveryFix.js"
    ],
    "extra": {
      "eas": {
        "projectId": "54f1e2e9-6637-4136-9e2e-62c4a0b09777"
      }
    }
  }
}
